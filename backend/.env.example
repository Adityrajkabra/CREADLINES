# CrediLens Backend Environment Configuration

# Application Server
PORT=8000
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173

# Database (Leave unset for local persistent SQLite credilens_users.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/credilens

# JWT Security
JWT_SECRET_KEY=credilens-institutional-fintech-jwt-secret-2026

# Gmail / SMTP Email Delivery Configuration
# For Gmail:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Paste your Gmail address and 16-character App Password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CrediLens Underwriting Security

# OTP Security Parameters
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3

# ========================================================
# FINANCIAL DATA INTEGRATION HUB (SANDBOX & PROVIDERS)
# ========================================================

# Integration 1: Razorpay Payment Gateway (Test Mode / Sandbox)
# Obtain test credentials from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_SECRET=

# Integration 2: Bank Account Aggregator (ReBIT / Sahamati Framework)
# Configure authorized partner credentials (e.g. Setu, Finvu, OneMoney, Anumati)
AA_PROVIDER=sahamati_rebit
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_PRODUCT_ID=

# Integration 3: GST Business Data (GST Suvidha Provider - GSP)
# Configure authorized GSP credentials (e.g. Masters India, ClearTax, Vayana, Cygnet)
GST_PROVIDER=masters_india
GST_CLIENT_ID=
GST_CLIENT_SECRET=
GST_USERNAME=
